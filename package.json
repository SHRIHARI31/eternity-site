    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.2",
    "@lottiefiles/lottie-player": "^2.0.12",
    "@primeuix/themes": "^2.0.2",
    "express": "^5.1.0",
    "lottie-web": "^5.13.0",
